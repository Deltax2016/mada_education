# Copy to apps/api/.env and apps/web/.env.local for local work.
# Real values live only in Coolify environment variables.

APP_ENV=development
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8010

# SQLite by default so the stack runs with no infrastructure. With
# APP_ENV=production the app refuses to start on SQLite, because there it is
# always a missing DATABASE_URL rather than a choice, and the data would vanish
# on the next deploy without anyone noticing.
#
# Any managed Postgres URL works as pasted: postgres://, postgresql:// and
# postgresql+psycopg2:// are all rewritten to the async driver, and libpq's
# sslmode is translated for asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./mada.db

JWT_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
# Development only. In production the code only goes out by email.
OTP_ECHO_IN_RESPONSE=true

# Email is the only way in, so this is on the critical path for sign-in.
#
# Before the domain is verified in Resend, a new account can only deliver to the
# address that owns it. Keep the resend.dev sender until verification passes:
#   MAIL_FROM=Mada <onboarding@resend.dev>
#
# After verifying a sending subdomain, switch to it. A subdomain rather than the
# root keeps sign-in mail reputation separate from anything sent from the main
# domain later:
#   MAIL_FROM=Mada <no-reply@send.mada-tech.space>
RESEND_API_KEY=
MAIL_FROM=Mada <onboarding@resend.dev>

DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en
DEFAULT_TIMEZONE=Asia/Muscat
DEFAULT_CURRENCY=OMR

# Storage over the S3 API: MinIO locally, Cloudflare R2 in production.
# Leave the keys empty to fall back to local disk.
#
# For R2 the endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com and the
# keys are the R2 Access Key ID and Secret Access Key, pasted as is.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL=14400

# TWO buckets on purpose. Attaching a public custom domain to a bucket makes
# every object in it readable by anyone who knows the key, so paid video and
# submitted homework cannot share a bucket with the covers.
S3_BUCKET=mada-media                # private: video, documents, submissions
S3_PUBLIC_BUCKET=                   # public: covers and avatars only
S3_PUBLIC_BASE_URL=                 # custom domain on the PUBLIC bucket

# Thawani. NOT IMPLEMENTED YET.
#
# Leave empty and, outside production, checkout runs a simulated purchase that
# grants access without charging: fine for trying the flow, useless as a shop.
#
# Fill them and checkout returns 501 instead. That is deliberate: credentials
# present means someone expects real charges, and quietly running the simulator
# would give paid courses away.
#
# Amounts go over the wire in baisa as whole numbers when this is written.
THAWANI_BASE_URL=
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=

# No SENTRY_DSN: the SDK is not installed, so the variable would do nothing.
LOG_LEVEL=info
