# Copy to apps/api/.env and apps/web/.env.local for local work.
# Real values live only in Coolify environment variables.

APP_ENV=development
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8010

# SQLite by default so the stack runs with no infrastructure.
# Compose uses postgresql+asyncpg://mada:...@postgres:5432/mada
DATABASE_URL=sqlite+aiosqlite:///./mada.db

JWT_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
# Development only. In production the code only goes out by email.
OTP_ECHO_IN_RESPONSE=true

# Email is the only way in, so this is on the critical path for sign-in.
# A new Resend account can only send to the address that owns it until a sending
# domain is verified; until then MAIL_FROM must stay on the resend.dev sender.
RESEND_API_KEY=
MAIL_FROM=Mada <onboarding@resend.dev>

DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en
DEFAULT_TIMEZONE=Asia/Muscat
DEFAULT_CURRENCY=OMR

# Storage. These five lines are the whole difference between MinIO and R2.
# Leave the keys empty to fall back to local disk.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mada-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL=14400

# Thawani. Amounts go over the wire in baisa as whole numbers.
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=

SENTRY_DSN=
LOG_LEVEL=info
